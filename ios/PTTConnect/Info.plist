<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>PTT Connect</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key><dict/>
    <key>UIRequiresFullScreen</key><true/>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
    <key>PTTApiBaseURL</key><string>$(PTT_API_BASE_URL)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>PTT Connect uses the microphone only while you hold the talk button.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>PTT Connect can use Bluetooth headsets and PTT buttons.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>push-to-talk</string>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
